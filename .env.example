# Clave secreta para sesiones y protección CSRF (generar con secrets.token_hex(32))
SECRET_KEY=coloca-aqui-una-clave-secreta-aleatoria

# Modo de depuración de Flask (1 para desarrollo, 0 para producción)
FLASK_DEBUG=1

# Base de datos (opcional, por defecto usa SQLite en instance/mdg_cibersegura.db)
# DATABASE_URL=sqlite:///instance/mdg_cibersegura.db
